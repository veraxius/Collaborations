# Per-customer settings for a private installation. Copy to customer.env.

# --- URLs (the public addresses of this customer's install) ---
APP_URL=https://compliance.customer.com
API_URL=https://api.compliance.customer.com

# --- Secrets (generate fresh values for every customer) ---
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me

# --- Branding ---
BRAND_NAME=Customer Compliance
# Optional: square logo URL, and accent colors (hex)
BRAND_LOGO_URL=
BRAND_ACCENT=#ffb100
BRAND_ACCENT_DARK=#8f5f00
# Text color used on top of the accent color (use #ffffff for dark accents)
BRAND_ON_ACCENT=#101820

# --- Email (Resend) and AI ---
EMAIL_FROM=Customer Compliance <reminders@customer.com>
RESEND_API_KEY=
GROQ_API_KEY=
