# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=fleetguard
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# --- Optional ---
PORT=3001
UPLOAD_DIR=./uploads

# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=FleetGuard <reminders@your-domain.com>
CONTACT_TO_EMAIL=you@your-domain.com

# Daily reminder sweep. Either run in-process...
ENABLE_INTERNAL_CRON=1
# ...or call POST /api/cron/reminders with "Authorization: Bearer $CRON_SECRET".
# The endpoint is disabled (503) when CRON_SECRET is empty.
CRON_SECRET=

# Billing (Lemon Squeezy): webhook URL = https://<api>/api/billing/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=
