# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=fleetguard
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# --- Optional ---
PORT=3001
UPLOAD_DIR=./uploads

# Email (Resend). Without a key, emails are printed to the console and new
# accounts are treated as verified. In production use a domain you verified.
RESEND_API_KEY=
EMAIL_FROM=FleetGuard <reminders@your-domain.com>
CONTACT_TO_EMAIL=you@your-domain.com

# Scheduled jobs (daily reminders 08:00, onboarding nudge 08:30, Monday summary).
# Either run them in-process...
ENABLE_INTERNAL_CRON=1
# ...or call POST /api/cron/reminders|digest|nudge with "Authorization: Bearer $CRON_SECRET".
# The endpoints are disabled (503) when CRON_SECRET is empty.
CRON_SECRET=

# Billing (Lemon Squeezy): webhook URL = https://<api>/api/billing/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=

# USDOT lookup on sign-up (free key from FMCSA, needs a Login.gov account)
FMCSA_WEBKEY=

# Text messages to drivers (Twilio). Without these, messages are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Private (white-label) installs only
# DEPLOYMENT_MODE=private
# BRAND_NAME=Customer Compliance
