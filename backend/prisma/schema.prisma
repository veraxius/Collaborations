generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["fleetguard"]
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())
  trialEndsAt        DateTime
  lsCustomerId       String?
  lsSubscriptionId   String?  @unique
  subscriptionStatus String   @default("trialing")
  contactName        String?
  phone              String?
  country            String?
  // What the company operates: trucking | nemt | last-mile | shuttle.
  // Drives which quick-start documents and wording the app shows.
  vertical           String   @default("trucking")

  // USDOT number (optional). Used to prefill the company and compute MCS-150.
  usdot              String?
  // New sign-ups start unverified; accounts created before this column existed count as verified.
  emailVerified      Boolean  @default(true)
  // Reminder settings. Offsets are days before expiry, comma separated.
  reminderOffsets    String   @default("30,15,7,1")
  // Extra recipients for reminders (comma separated emails), besides the owner.
  reminderEmails     String   @default("")
  // Also notify drivers about their own documents (email and SMS when configured).
  notifyDrivers      Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  nudgeSentAt        DateTime?
  // Billing details received from the Lemon Squeezy webhook.
  lsPortalUrl        String?
  planRenewsAt       DateTime?
  planEndsAt         DateTime?

  vehicles  Vehicle[]
  drivers   Driver[]
  documents Document[]
  events    ActivityEvent[]
  snapshots ComplianceSnapshot[]
  team      TeamMember[]

  @@schema("fleetguard")
}

/// Extra people who can sign in to a company's account. The owner is the Company itself.
model TeamMember {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  // manager: can edit data. viewer: read only.
  role         String   @default("viewer")
  // Empty until the invitation is accepted.
  passwordHash String   @default("")
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@schema("fleetguard")
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("web")
  usdot     String?
  createdAt DateTime @default(now())

  @@schema("fleetguard")
}

model Vehicle {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  plate      String
  type       String   @default("truck")
  status     String   @default("active")
  make       String?
  model      String?
  year       Int?
  vin        String?
  odometerKm Int?
  notes      String?
  createdAt  DateTime @default(now())

  documents Document[]

  @@index([companyId])
  @@schema("fleetguard")
}

model Driver {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  status        String    @default("active")
  email         String?
  phone         String?
  licenseNumber String?
  licenseClass  String?
  hiredAt       DateTime?
  birthDate     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  documents Document[]

  @@index([companyId])
  @@schema("fleetguard")
}

model Document {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type            String
  title           String
  referenceNumber String?
  issuer          String?
  issuedAt        DateTime?
  expiresAt       DateTime
  cost            Float?
  currency        String    @default("USD")
  fileName        String?
  notes           String?
  createdAt       DateTime  @default(now())
  sentReminders   String    @default("")

  @@index([companyId])
  @@index([expiresAt])
  @@schema("fleetguard")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  label     String
  // Who did it (email of the signed-in user).
  actor     String?
  onTime    Boolean?
  daysDelta Int?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@schema("fleetguard")
}

model ComplianceSnapshot {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      String
  score     Int
  expired   Int
  expiring  Int
  ok        Int
  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@schema("fleetguard")
}
