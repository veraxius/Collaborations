# -------------------------
# DEPENDENCIES
# -------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -------------------------
# BUILD / OUTPUT
# -------------------------
dist/
build/
.next/
out/

# -------------------------
# ENV FILES (SENSIBLE)
# -------------------------
.env
.env.*
!.env.example
!.env.local.example
!.env.fleetguard.example

# Per-customer secrets for private installs
customer.env
customer-*.env

# Rendered marketing videos and stills (regenerate with `npm run render` in marketing-videos/)
marketing-videos/out/

# User uploads must never be committed
backend/uploads/

# -------------------------
# LOGS
# -------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# TESTING
# -------------------------
coverage/

# -------------------------
# VERCEL
# -------------------------
.vercel

# -------------------------
# OS / MISC
# -------------------------
.DS_Store
*.pem

# -------------------------
# TYPESCRIPT
# -------------------------
*.tsbuildinfo
next-env.d.ts